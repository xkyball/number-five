[Unit]
Description=No5 password verifier for the HTTPS gateway
After=network.target

[Service]
Type=simple
User=no5auth
Group=no5auth
ExecStart=/usr/bin/python3 /usr/local/libexec/no5-password-auth.py --record /var/lib/no5-password-auth/record.json --key-hash /etc/no5-password-auth/key.json --ca /usr/local/share/no5-gateway/ca.crt
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/no5-password-auth
RestrictAddressFamilies=AF_INET
UMask=0077
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
