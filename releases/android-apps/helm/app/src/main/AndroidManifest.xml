<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.no5.home"/>
        <package android:name="com.no5.helm"/>
        <package android:name="com.no5.map"/>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/></intent>
    </queries>
    <permission android:name="com.no5.permission.SPECIAL_KEYBOARD_GEOMETRY" android:protectionLevel="signature" />
    <uses-permission android:name="com.no5.permission.SPECIAL_KEYBOARD_GEOMETRY" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Explicitly user-granted during `lumina-control enable`; never requested silently. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <permission android:name="com.no5.helm.permission.SYSTEM_CONTROL" android:protectionLevel="signature" />
    <uses-permission android:name="com.no5.helm.permission.SYSTEM_CONTROL" />
    <!-- Normal/install-time permission only: invalidates the bounded mDNS cache on network changes. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- User-selected LAN simulator supports HTTP. No credentials or writes are sent.
         Android cannot declare private IP ranges in a domain security configuration. -->
    <uses-permission android:name="com.no5.lumina.control.permission.KNOB_LEASE" />
    <queries><package android:name="com.no5.lumina.control" /></queries>
    <application android:allowBackup="false" android:usesCleartextTraffic="true" android:supportsRtl="true" android:label="No5 HELM" android:theme="@style/Theme.No5">
        <service android:name=".control.HelmSourceService" android:exported="true"
            android:permission="com.no5.helm.permission.SYSTEM_CONTROL" android:foregroundServiceType="mediaPlayback" />
        <receiver android:name=".control.LuminaBootReceiver" android:exported="false" android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:screenOrientation="sensorLandscape">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <activity android:name="com.no5.releaseinfo.AboutActivity" android:exported="false" android:theme="@android:style/Theme.Material.NoActionBar" />
        <receiver android:name="com.no5.releaseinfo.PackageReplacedReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
        <!-- Shell already holds DUMP; the provider additionally checks the exact caller UID. -->
        <provider android:name="com.no5.releaseinfo.ReleaseProvider" android:authorities="${applicationId}.releaseinfo" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- Provider also verifies caller UID; this is the only ADB operator endpoint. -->
        <provider android:name=".control.LuminaControlProvider" android:authorities="${applicationId}.lumina-control" android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
